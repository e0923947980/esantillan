<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="esantillan.Views.vActualizarEliminar"
             Title="vActualizarEliminar">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*,*"
          Padding="20"
          RowSpacing="10">

        <Label Grid.Row="0" Grid.ColumnSpan="2"
               Text="ACTUALIZAR - ELIMINAR ESTUDIANTE"
               FontSize="20"
               HorizontalOptions="Center" />

        <Label Grid.Row="1" Grid.Column="0" Text="CODIGO" VerticalOptions="Center" />
        <Entry x:Name="txtCodigo" Grid.Row="1" Grid.Column="1" IsEnabled="False" />

        <Label Grid.Row="2" Grid.Column="0" Text="NOMBRE" VerticalOptions="Center" />
        <Entry x:Name="txtNombre" Grid.Row="2" Grid.Column="1" />

        <Label Grid.Row="3" Grid.Column="0" Text="APELLIDO" VerticalOptions="Center" />
        <Entry x:Name="txtApellido" Grid.Row="3" Grid.Column="1" />

        <Label Grid.Row="4" Grid.Column="0" Text="EDAD" VerticalOptions="Center" />
        <Entry x:Name="txtEdad" Grid.Row="4" Grid.Column="1" Keyboard="Numeric" />

        <Label x:Name="lblMensaje" Grid.Row="5" Grid.ColumnSpan="2" TextColor="Red" />

        <Button x:Name="btnActualizar"
                Grid.Row="6" Grid.Column="0"
                Text="Actualizar"
                BackgroundColor="#512BD4"
                TextColor="White"
                Clicked="btnActualizar_Clicked" />

        <Button x:Name="btnEliminar"
                Grid.Row="6" Grid.Column="1"
                Text="Eliminar"
                BackgroundColor="Red"
                TextColor="White"
                Clicked="btnEliminar_Clicked" />
    </Grid>
</ContentPage>
