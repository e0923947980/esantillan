<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="esantillan.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:esantillan.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="esantillan">

    <TabBar>
        <ShellContent
            Title="Estudiantes"
            ContentTemplate="{DataTemplate views:vEstudiante}"
            Route="vEstudiante" />

        <ShellContent
            Title="Personas"
            ContentTemplate="{DataTemplate views:vPersona}"
            Route="vPersona" />
    </TabBar>

</Shell>
